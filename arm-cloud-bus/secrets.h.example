/*
 * 凭据配置模板
 *
 * 使用方法：
 *   cp secrets.h.example secrets.h
 * 然后填上你自己的值。
 *
 * ⚠️ secrets.h 已被 .gitignore 排除，不会提交到 Git。
 *    千万不要把真实密码写进 secrets.h.example（这个文件是要提交的）。
 */

// ---- WiFi（注意：ESP32 只支持 2.4GHz，连不上 5GHz 频段）----
#define WIFI_SSID       "你的WiFi名称"
#define WIFI_PASSWORD   "你的WiFi密码"

// ---- 服务器 ----
// 局域网测试：填你电脑的局域网 IP（macOS 用 `ipconfig getifaddr en0` 查）
// 公网部署：  填云服务器的公网 IP 或域名
#define SERVER_HOST     "192.168.1.100"
#define SERVER_PORT     3000

// ---- 连接暗号 ----
// 必须和 server/config.js 里的 ESP32_TOKEN 完全一致，否则服务器会直接断开连接
#define ESP32_TOKEN     "change-me-to-a-random-token"
